<% content_for :title, "{I18n.t('auth.forgot_title')} — Ronaitre" %>
<% content_for :robots_noindex, true %>

<div class="mx-auto flex min-h-[70vh] w-full max-w-md flex-col justify-center px-6 py-14">
  <h1 class="text-3xl font-extrabold tracking-tight"><%= t("auth.forgot_title") %></h1>
  <p class="mt-2 text-sm text-muted-foreground"><%= t("auth.forgot_subtitle") %></p>

  <%= form_with url: passwords_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= render FieldComponent.new(label: t("auth.email"), for_attr: "password_email_address") do %>
        <%= form.email_field :email_address, id: "password_email_address", required: true, autofocus: true,
                             autocomplete: "username", value: params[:email_address],
                             class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
      <% end %>
    </div>
    <%= form.submit t("auth.forgot_submit"), class: "inline-flex h-11 w-full items-center justify-center rounded-lg bg-primary px-6 font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-ring" %>
    <p class="text-center text-xs text-muted-foreground"><%= t("auth.signin_reassurance") %></p>
  <% end %>
</div>
