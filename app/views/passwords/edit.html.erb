<div class="mx-auto flex min-h-[70vh] w-full max-w-md flex-col justify-center px-6 py-14">
  <h1 class="text-3xl font-extrabold tracking-tight"><%= t("auth.reset_title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= render FieldComponent.new(label: t("auth.new_password"), for_attr: "password_password") do %>
        <%= form.password_field :password, id: "password_password", required: true,
                                autocomplete: "new-password", minlength: 8, maxlength: 72,
                                class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
      <% end %>
    </div>
    <div>
      <%= render FieldComponent.new(label: t("auth.password_confirmation"), for_attr: "password_password_confirmation") do %>
        <%= form.password_field :password_confirmation, id: "password_password_confirmation", required: true,
                                autocomplete: "new-password", maxlength: 72,
                                class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
      <% end %>
    </div>
    <%= form.submit t("auth.reset_submit"), class: "inline-flex h-11 w-full items-center justify-center rounded-lg bg-primary px-6 font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-ring" %>
  <% end %>
</div>
