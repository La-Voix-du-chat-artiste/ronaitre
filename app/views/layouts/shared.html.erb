<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground min-h-screen">
    <header class="border-b border-border bg-card">
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-5">
        <%= render LogoComponent.new %>
        <p class="text-xs text-muted-foreground"><%= t("shared_calendar.readonly") %></p>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-5 py-8">
      <% if notice %>
        <p class="mb-5 rounded-lg border border-primary/30 bg-primary/5 px-4 py-3 text-sm font-medium text-primary" role="status"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-5 rounded-lg border border-destructive/30 bg-destructive/5 px-4 py-3 text-sm font-medium text-destructive" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
    <footer class="mx-auto max-w-3xl px-5 py-6 text-center text-xs text-muted-foreground">
      <p><%= t("shared_calendar.footer") %> <%= link_to t("app.name"), root_path, class: "font-semibold text-primary hover:underline" %></p>
    </footer>
  </body>
</html>
