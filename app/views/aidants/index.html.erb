<% content_for :title, "Aidants — Ronaitre" %>

<section class="mx-auto max-w-4xl px-6 py-14">
  <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl"><%= t("aidants.title") %></h1>
  <p class="mt-3 max-w-2xl text-muted-foreground"><%= t("aidants.subtitle") %></p>

  <% if @aidants.empty? %>
    <%= render CardComponent.new(html: { class: "mt-10 p-10 text-center" }) do %>
      <p class="font-semibold"><%= t("aidants.empty_title") %></p>
      <p class="mt-2 text-sm text-muted-foreground"><%= t("aidants.empty_body") %></p>
    <% end %>
  <% else %>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <% @aidants.each do |aidant| %>
        <%= render CardComponent.new(html: { class: "p-6" }) do %>
          <p class="font-bold"><%= aidant.display_name.presence || t("aidants.anonymous_name") %></p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground"><%= aidant.bio.presence || t("aidants.no_bio") %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <p class="mt-10 text-sm text-muted-foreground"><%= t("aidants.disclaimer") %></p>
</section>
