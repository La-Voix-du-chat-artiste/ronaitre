<% content_for :title, "Invitation — Ronaitre" %>

<div class="mx-auto max-w-lg">
  <%= render CardComponent.new(html: { class: "p-8 text-center" }) do %>
    <h1 class="text-2xl font-extrabold tracking-tight"><%= t("invitations.title") %></h1>
    <p class="mt-3 text-muted-foreground">
      <%= @membership.owner.display_name.presence || @membership.owner.email_address %>
      <%= t("invitations.invites_you", kind: t("membership.kinds.#{@membership.kind}")) %>
    </p>
    <p class="mt-2 text-sm text-muted-foreground"><%= t("invitations.explanation") %></p>

    <div class="mt-6 flex justify-center gap-3">
      <%= button_to t("invitations.accept"), accept_by_token_invitation_path(@membership.invite_token), method: :post,
                    class: "inline-flex h-11 items-center rounded-lg bg-primary px-6 font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90" %>
      <%= link_to t("invitations.decline"), dashboard_path, class: "inline-flex h-11 items-center rounded-lg border border-border px-6 font-semibold text-muted-foreground hover:bg-muted" %>
    </div>
  <% end %>
</div>
