<% content_for :title, "#{t('app.name')} — #{t('app.tagline')}" %>
<% content_for :head do %>
  <%= render_json_ld(json_ld_software_application, json_ld_organization, json_ld_faq) %>
<% end %>

<%# 3. Hero — skin docs/screenshot.png : fond vert, texte blanc, CTA orange, mockup produit %>
<section class="bg-primary" id="haut">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-2 lg:items-center lg:py-28">
    <div>
      <%= render(BadgeComponent.new(variant: :white)) { t("landing.hero.badge") } %>
      <h1 class="mt-6 text-5xl font-extrabold leading-none tracking-tight text-white sm:text-6xl xl:text-7xl">
        <%= t("landing.hero.title") %>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85"><%= t("landing.hero.subtitle") %></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= render(ButtonComponent.new(variant: :primary, size: :lg, href: signup_path)) { t("nav.start_free") } %>
        <%= render(ButtonComponent.new(variant: :outline, size: :lg, href: auth_path)) { t("landing.hero.secondary_cta") } %>
      </div>
      <p class="mt-5 text-sm text-white/70"><%= t("landing.hero.reassurance") %></p>
    </div>

    <%# Mockup produit en pur CSS — audit P1 %>
    <div class="lg:justify-self-end" aria-hidden="true">
      <%= render CardComponent.new(html: { class: "w-full max-w-sm p-6 shadow-xl" }) do %>
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-muted-foreground"><%= t("landing.hero.demo_track") %></p>
          <%= render(BadgeComponent.new(variant: :mint)) { "Suivi actif" } %>
        </div>
        <div class="mt-5" data-controller="live-counter" data-live-counter-elapsed-value="<%= 47 * 86_400 + 1 * 3600 + 12 * 60 + 44 %>">
          <p class="text-sm text-muted-foreground">Votre progression</p>
          <p class="mt-1 flex items-baseline gap-2">
            <span data-live-counter-target="days" class="text-7xl font-extrabold leading-none tracking-tight text-primary">47</span>
            <span class="text-2xl font-bold text-muted-foreground"><%= t("landing.hero.demo_days") %></span>
          </p>
          <p data-live-counter-target="time" class="counter-digits mt-2 text-3xl text-foreground">01:12:44</p>
          <div class="mt-5 space-y-2 text-sm">
            <div class="flex items-center justify-between gap-3 rounded-lg bg-muted px-3 py-2">
              <span class="shrink-0">24 h sans fumer</span><span class="counter-digits shrink-0 font-semibold text-primary">J+1</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-lg bg-muted px-3 py-2">
              <span class="shrink-0">7 jours — le plus dur est passé</span><span class="counter-digits shrink-0 font-semibold text-primary">J+7</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-lg bg-muted px-3 py-2">
              <span class="shrink-0">1 mois — respiration retrouvée</span><span class="counter-digits shrink-0 font-semibold text-primary">J+30</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-lg border border-primary/30 bg-primary/5 px-3 py-2">
              <span class="shrink-0 font-medium">3 mois</span><span class="counter-digits text-muted-foreground"><%= t("landing.hero.demo_next") %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 4. Comment ça marche %>
<section id="fonctionnement" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <%= render SectionHeadingComponent.new(eyebrow: "01 — Comment ça marche", title: t("landing.steps.title"), subtitle: t("landing.steps.subtitle")) %>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <% [["1", t("landing.steps.one_title"), t("landing.steps.one_body")],
          ["2", t("landing.steps.two_title"), t("landing.steps.two_body")],
          ["3", t("landing.steps.three_title"), t("landing.steps.three_body")]].each do |number, title, body| %>
        <%= render CardComponent.new(html: { class: "p-7" }) do %>
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-lg font-bold text-primary-foreground"><%= number %></div>
          <h3 class="mt-4 text-lg font-bold"><%= title %></h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= body %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# 5. Le produit %>
<section id="produit" class="bg-muted py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <%= render SectionHeadingComponent.new(eyebrow: "02 — Le produit", title: t("landing.product.title"), subtitle: t("landing.product.subtitle")) %>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <%= render CardComponent.new(html: { class: "p-7" }) do %>
        <div class="space-y-2" aria-hidden="true">
          <% [["Tabac", "47 j"], ["Alcool", "12 j"], ["Écrans", "5 j"]].each do |name, days| %>
            <div class="flex items-center justify-between rounded-lg border border-border bg-card px-3 py-2 text-sm">
              <span class="font-medium"><%= name %></span>
              <span class="counter-digits font-semibold text-primary"><%= days %></span>
            </div>
          <% end %>
          <div class="rounded-lg border border-dashed border-border px-3 py-2 text-center text-sm text-muted-foreground">+ Nouveau suivi</div>
        </div>
        <h3 class="mt-5 text-lg font-bold"><%= t("landing.product.card1_title") %></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= t("landing.product.card1_body") %></p>
      <% end %>
      <%= render CardComponent.new(html: { class: "p-7" }) do %>
        <div class="flex items-center gap-3" aria-hidden="true">
          <span class="text-4xl font-extrabold text-primary">J+47</span>
          <%= render(BadgeComponent.new(variant: :secondary)) { "Record personnel" } %>
        </div>
        <div class="mt-4 flex gap-1.5" aria-hidden="true">
          <% 24.times do |i| %><span class="h-8 flex-1 rounded-sm <%= i < 19 ? "bg-primary/70" : "bg-muted" %>"></span><% end %>
        </div>
        <h3 class="mt-5 text-lg font-bold"><%= t("landing.product.card2_title") %></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= t("landing.product.card2_body") %></p>
      <% end %>
      <%= render CardComponent.new(html: { class: "p-7" }) do %>
        <div class="flex items-center gap-3" aria-hidden="true">
          <div class="flex -space-x-2">
            <% %w[bg-periwinkle bg-salmon bg-mint].each do |color| %>
              <span class="inline-block h-8 w-8 rounded-full border-2 border-card <%= color %>"></span>
            <% end %>
          </div>
          <span class="text-sm font-semibold">+ 23 proches</span>
        </div>
        <div class="mt-4 inline-flex items-center gap-2 rounded-lg bg-primary/10 px-3 py-1.5 text-sm font-medium text-primary" aria-hidden="true">
          <%= t("landing.product.card3_badge") %> · <span class="text-muted-foreground"><%= t("landing.product.card3_note") %></span>
        </div>
        <h3 class="mt-5 text-lg font-bold"><%= t("landing.product.card3_title") %></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= t("landing.product.card3_body") %></p>
      <% end %>
    </div>
  </div>
</section>

<%# 6. Pourquoi Ronaitre — 4 engagements (audit P10) %>
<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <%= render SectionHeadingComponent.new(eyebrow: "03 — Pourquoi Ronaitre", title: t("landing.why.title")) %>
    <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2">
      <% { private: t("landing.why.private_title"), realtime: t("landing.why.realtime_title"),
           relapse: t("landing.why.relapse_title"), free: t("landing.why.free_title") }.each_with_index do |(key, title), i| %>
        <div>
          <p class="counter-digits text-sm font-bold text-primary">/ 0<%= i + 1 %></p>
          <h3 class="mt-2 text-xl font-bold"><%= title %></h3>
          <p class="mt-3 leading-relaxed text-muted-foreground"><%= t("landing.why.#{key}_body") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 7. Entourage %>
<section id="entourage" class="bg-muted py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <%= render SectionHeadingComponent.new(eyebrow: "04 — Entourez-vous", title: t("landing.circle.title"), subtitle: t("landing.circle.subtitle")) %>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <%= render CardComponent.new(html: { class: "p-7" }) do %>
        <h3 class="text-lg font-bold"><%= t("landing.circle.helpers_title") %></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= t("landing.circle.helpers_body") %></p>
        <p class="mt-4"><%= link_to "Découvrir le réseau d'aidants", signup_path, class: "text-sm font-semibold text-primary hover:underline" %></p>
      <% end %>
      <%= render CardComponent.new(html: { class: "p-7" }) do %>
        <h3 class="text-lg font-bold"><%= t("landing.circle.loved_ones_title") %></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= t("landing.circle.loved_ones_body") %></p>
        <p class="mt-4"><%= link_to "Inviter un proche", signup_path, class: "text-sm font-semibold text-primary hover:underline" %></p>
      <% end %>
      <%= render CardComponent.new(html: { class: "p-7" }) do %>
        <h3 class="text-lg font-bold"><%= t("landing.circle.carers_title") %></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><%= t("landing.circle.carers_body") %></p>
        <p class="mt-4"><%= link_to t("landing.circle.csapa"), "https://www.drogues-info-service.fr/annuaire", target: "_blank", rel: "noopener", class: "text-sm font-semibold text-primary hover:underline" %></p>
      <% end %>
    </div>
    <%= render EncartComponent.new(variant: :help, html: { class: "mt-10" }) do %>
      <p><%= t("landing.circle.disclaimer") %></p>
    <% end %>
  </div>
</section>

<%# 8. Témoignages (maquette de démonstration) %>
<section id="temoignages" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <%= render SectionHeadingComponent.new(eyebrow: "05 — Ils témoignent", title: t("landing.testimonials.title")) %>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <% t("landing.testimonials.items").each do |item| %>
        <figure class="flex h-full flex-col rounded-lg border border-border bg-card p-7 shadow-sm">
          <blockquote class="flex-1 leading-relaxed text-foreground">«&nbsp;<%= item[:quote] %>&nbsp;»</blockquote>
          <figcaption class="mt-5">
            <p class="text-sm font-bold"><%= item[:author] %></p>
            <p class="text-sm text-muted-foreground"><%= item[:context] %></p>
          </figcaption>
        </figure>
      <% end %>
    </div>
    <p class="mt-6 text-center text-sm text-muted-foreground"><%= t("landing.testimonials.demo_notice") %></p>
  </div>
</section>

<%# 9. FAQ %>
<section id="faq" class="bg-muted py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-6">
    <%= render SectionHeadingComponent.new(eyebrow: "06 — Questions fréquentes", title: t("landing.faq.title")) %>
    <div class="mt-10 space-y-3">
      <% t("landing.faq.items").each do |item| %>
        <details class="group rounded-lg border border-border bg-card px-5 open:shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-semibold [&::-webkit-details-marker]:hidden">
            <%= item[:question] %>
            <span class="text-xl text-muted-foreground transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="pb-5 leading-relaxed text-muted-foreground"><%= item[:answer] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>

<%# 10. CTA finale %>
<section class="bg-primary py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl"><%= t("landing.final_cta.title") %></h2>
    <p class="mt-4 text-lg text-white/85"><%= t("landing.final_cta.subtitle") %></p>
    <div class="mt-8">
      <%= render(ButtonComponent.new(variant: :primary, size: :lg, href: signup_path)) { t("nav.start_free") } %>
    </div>
    <p class="mt-5 text-sm text-white/70"><%= t("landing.hero.reassurance") %></p>
  </div>
</section>
