<% content_for :title, "Réglages — Ronaitre" %>

<h1 class="text-3xl font-extrabold tracking-tight"><%= t("settings.title") %></h1>

<div class="mt-8 max-w-xl space-y-5">
  <%= render CardComponent.new(html: { class: "p-7" }) do %>
    <h2 class="font-bold"><%= t("settings.profile") %></h2>
    <%= form_with model: Current.user, url: settings_path, method: :patch, class: "mt-5 space-y-5" do |form| %>
      <div>
        <%= render FieldComponent.new(label: t("settings.email"), for_attr: "user_email") do %>
          <%= form.email_field :email_address, id: "user_email", disabled: true,
                               class: "h-10 w-full rounded-lg border border-input bg-muted px-3 text-sm text-muted-foreground" %>
        <% end %>
      </div>
      <div>
        <%= render FieldComponent.new(label: t("settings.display_name"), for_attr: "user_display_name", hint: t("settings.display_name_hint")) do %>
          <%= form.text_field :display_name, id: "user_display_name", maxlength: 40,
                              class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
        <% end %>
      </div>
      <div>
        <%= render FieldComponent.new(label: t("settings.phone"), for_attr: "user_phone", hint: t("settings.phone_hint")) do %>
          <%= form.telephone_field :phone, id: "user_phone",
                                   class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
        <% end %>
      </div>
      <label class="flex items-center gap-3 text-sm">
        <%= form.check_box :anonymous, class: "h-4 w-4 rounded border-input accent-primary" %>
        <span><%= t("settings.anonymous") %></span>
      </label>
      <%= form.submit t("settings.save"), class: "inline-flex h-10 items-center justify-center rounded-lg bg-primary px-5 font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-ring" %>
    <% end %>
  <% end %>

  <%= render CardComponent.new(html: { class: "p-7" }) do %>
    <h2 class="font-bold"><%= t("settings.data") %></h2>
    <p class="mt-1 text-sm text-muted-foreground"><%= t("settings.data_help") %></p>
    <div class="mt-4">
      <%= link_to t("settings.export"), export_settings_path, class: "inline-flex h-10 items-center rounded-lg border border-border px-4 text-sm font-semibold hover:bg-muted" %>
    </div>
  <% end %>

  <%= render CardComponent.new(html: { class: "border-destructive/20 p-7" }) do %>
    <h2 class="font-bold text-destructive"><%= t("settings.danger_zone") %></h2>
    <p class="mt-1 text-sm text-muted-foreground"><%= t("settings.deletion_help") %></p>
    <div class="mt-4">
      <%= button_to t("settings.delete_account"), destroy_account_settings_path, method: :delete,
                    data: { turbo_confirm: t("settings.delete_confirm") },
                    class: "inline-flex h-10 items-center rounded-lg bg-destructive px-4 text-sm font-semibold text-destructive-foreground hover:brightness-110" %>
    </div>
  <% end %>
</div>
