<div class="mx-auto flex min-h-[70vh] w-full max-w-md flex-col justify-center px-6 py-14">
  <% if params[:mode] == "signup" %>
    <h1 class="text-3xl font-extrabold tracking-tight"><%= t("auth.signup_title") %></h1>
    <p class="mt-2 text-sm text-muted-foreground"><%= t("auth.signup_subtitle") %></p>

    <%= form_with url: signup_path, method: :post, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= render FieldComponent.new(label: t("auth.email"), for_attr: "user_email_address") do %>
          <%= form.email_field :email_address, id: "user_email_address", required: true, autofocus: true,
                               autocomplete: "username", value: params[:email_address],
                               class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
        <% end %>
      </div>
      <div>
        <%= render FieldComponent.new(label: t("auth.password"), for_attr: "user_password", hint: t("auth.password_hint")) do %>
          <div data-controller="password-visibility" class="relative">
            <%= form.password_field :password, id: "user_password", data: { password_visibility_target: "input" },
                                    required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
                                    class: "h-10 w-full rounded-lg border border-input bg-card px-3 pr-16 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
            <label class="absolute right-3 top-1.5 flex cursor-pointer items-center gap-1 text-xs font-semibold text-primary">
              <input type="checkbox" data-action="password-visibility#toggle" class="peer sr-only" />
              <span data-password-visibility-target="showLabel"><%= t("auth.show") %></span>
              <span data-password-visibility-target="hideLabel" class="hidden"><%= t("auth.hide") %></span>
            </label>
          </div>
        <% end %>
      </div>
      <div>
        <%= render FieldComponent.new(label: t("auth.password_confirmation"), for_attr: "user_password_confirmation") do %>
          <%= form.password_field :password_confirmation, id: "user_password_confirmation", required: true,
                                  autocomplete: "new-password", maxlength: 72,
                                  class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
        <% end %>
      </div>
      <%= form.submit t("auth.signup_submit"), class: "inline-flex h-11 w-full items-center justify-center rounded-lg bg-secondary px-6 font-semibold text-secondary-foreground shadow-sm transition hover:brightness-95 focus-visible:outline-2 focus-visible:outline-ring" %>
      <p class="text-center text-xs text-muted-foreground"><%= t("auth.signup_reassurance") %></p>
    <% end %>

    <p class="mt-6 text-center text-sm text-muted-foreground">
      <%= t("auth.have_account") %>
      <%= link_to t("nav.sign_in"), auth_path, class: "font-semibold text-primary hover:underline" %>
    </p>
  <% else %>
    <h1 class="text-3xl font-extrabold tracking-tight"><%= t("auth.signin_title") %></h1>
    <p class="mt-2 text-sm text-muted-foreground"><%= t("auth.signin_subtitle") %></p>

    <%= form_with url: session_path, method: :post, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= render FieldComponent.new(label: t("auth.email"), for_attr: "session_email_address") do %>
          <%= form.email_field :email_address, id: "session_email_address", required: true, autofocus: true,
                               autocomplete: "username", value: params[:email_address],
                               class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
        <% end %>
      </div>
      <div>
        <%= render FieldComponent.new(label: t("auth.password"), for_attr: "session_password") do %>
          <div data-controller="password-visibility" class="relative">
            <%= form.password_field :password, id: "session_password", data: { password_visibility_target: "input" },
                                    required: true, autocomplete: "current-password", maxlength: 72,
                                    class: "h-10 w-full rounded-lg border border-input bg-card px-3 pr-16 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
            <label class="absolute right-3 top-1.5 flex cursor-pointer items-center gap-1 text-xs font-semibold text-primary">
              <input type="checkbox" data-action="password-visibility#toggle" class="peer sr-only" />
              <span data-password-visibility-target="showLabel"><%= t("auth.show") %></span>
              <span data-password-visibility-target="hideLabel" class="hidden"><%= t("auth.hide") %></span>
            </label>
          </div>
        <% end %>
      </div>
      <div class="flex items-center justify-between">
        <%= link_to t("auth.forgot_password"), new_password_path, class: "text-sm text-muted-foreground hover:text-foreground hover:underline" %>
      </div>
      <%= form.submit t("auth.signin_submit"), class: "inline-flex h-11 w-full items-center justify-center rounded-lg bg-primary px-6 font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-ring" %>
      <p class="text-center text-xs text-muted-foreground"><%= t("auth.signin_reassurance") %></p>
    <% end %>

    <p class="mt-6 text-center text-sm text-muted-foreground">
      <%= t("auth.no_account") %>
      <%= link_to t("nav.sign_up"), signup_path, class: "font-semibold text-primary hover:underline" %>
    </p>
  <% end %>
</div>
