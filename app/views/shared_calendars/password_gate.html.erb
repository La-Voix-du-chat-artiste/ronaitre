<div class="mx-auto max-w-sm py-16">
  <%= render CardComponent.new(html: { class: "p-8 text-center" }) do %>
    <h1 class="text-xl font-extrabold tracking-tight"><%= t("shared_calendar.gate_title") %></h1>
    <p class="mt-2 text-sm text-muted-foreground"><%= t("shared_calendar.gate_help") %></p>
    <%= form_with url: shared_calendar_path(@share.token), class: "mt-6 space-y-4" do |form| %>
      <%= render FieldComponent.new(label: t("shared_calendar.password"), for_attr: "share_password") do %>
        <%= form.password_field :password, id: "share_password", required: true, autofocus: true,
                                class: "h-10 w-full rounded-lg border border-input bg-card px-3 text-sm focus-visible:outline-2 focus-visible:outline-ring" %>
      <% end %>
      <% if flash[:alert] %>
        <p class="text-sm text-destructive" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= form.submit t("shared_calendar.unlock"), class: "inline-flex h-10 w-full items-center justify-center rounded-lg bg-primary font-semibold text-primary-foreground shadow-sm hover:bg-primary/90" %>
    <% end %>
  <% end %>
</div>
