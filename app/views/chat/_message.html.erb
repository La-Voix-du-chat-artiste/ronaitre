<div class="flex <%= message.role == "user" ? "justify-end" : "justify-start" %>">
  <div class="max-w-[80%] rounded-lg px-4 py-2.5 text-sm <%= message.role == "user" ? "bg-primary text-primary-foreground" : "bg-muted text-foreground" %>">
    <p class="whitespace-pre-wrap leading-relaxed"><%= message.content %></p>
  </div>
</div>
